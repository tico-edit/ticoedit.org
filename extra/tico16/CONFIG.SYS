[MENU]
MENUITEM=NORMAL, Normal: EMS, CD-ROM and sound
MENUITEM=GAMES, Games: no EMS, most free memory
MENUITEM=WIN, Windows 3.11 for Workgroups
MENUITEM=CLEAN, Clean boot: no drivers
MENUDEFAULT=NORMAL, 10
MENUCOLOR=15, 1

[COMMON]
DEVICE=C:\DOS\HIMEM.SYS /TESTMEM:OFF
DOS=HIGH,UMB
FILES=40
BUFFERS=20,0
LASTDRIVE=Z
STACKS=9,256
SHELL=C:\COMMAND.COM C:\ /E:1024 /P

[NORMAL]
DEVICE=C:\DOS\EMM386.EXE RAM 2048 I=B000-B7FF X=C800-CBFF HIGHSCAN NOVCPI
DEVICEHIGH=C:\CDROM\OAKCDROM.SYS /D:MSCD001
DEVICEHIGH=C:\SB16\DRV\CTSB16.SYS /UNIT=0 /BLASTER=A:220 I:5 D:1 H:5
DEVICEHIGH=C:\DOS\SETVER.EXE
INSTALL=C:\DOS\SHARE.EXE /L:500 /F:5100

[GAMES]
DEVICE=C:\DOS\EMM386.EXE NOEMS I=B000-B7FF
DEVICEHIGH=C:\CDROM\OAKCDROM.SYS /D:MSCD001

[WIN]
INCLUDE=NORMAL
DEVICEHIGH=C:\WINDOWS\IFSHLP.SYS

[CLEAN]
